generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model AdminLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetId   String
  targetType String
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetId])
  @@index([createdAt])
}