generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Restaurant {
  id          String     @id @default(uuid())
  ownerId     String     @unique
  name        String
  description String?
  address     String
  phone       String
  imageUrl    String?
  isVerified  Boolean    @default(false)
  isOpen      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  menuItems   MenuItem[]
  orders      Order[]

  @@index([isVerified, isOpen])
  @@index([name])
}

model MenuItem {
  id           String      @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  price        Float
  category     String
  imageUrl     String?
  isAvailable  Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  orderItems   OrderItem[]

  @@index([restaurantId])
  @@index([restaurantId, isAvailable])
}

model Order {
  id           String      @id @default(uuid())
  customerId   String
  restaurantId String
  riderId      String?
  status       OrderStatus @default(PENDING)
  totalAmount  Float
  address      String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  items        OrderItem[]

  @@index([customerId])
  @@index([restaurantId])
  @@index([riderId])
  @@index([status])
  @@index([customerId, status])
  @@index([restaurantId, status])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Float
  order      Order    @relation(fields: [orderId], references: [id])
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  DELIVERED
  CANCELLED
}